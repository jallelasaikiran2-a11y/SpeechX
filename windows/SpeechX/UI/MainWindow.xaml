<Window x:Class="SpeechX.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SpeechX" Height="700" Width="1000"
        WindowStyle="None" ResizeMode="CanResize"
        AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterScreen">
    
    <Border Background="#EFEDE8" CornerRadius="12" BorderBrush="#141414" BorderThickness="1" x:Name="RootBorder">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="32"/> <!-- Custom Title Bar -->
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            
            <!-- Title bar for dragging -->
            <Border Grid.Row="0" Background="Transparent" MouseLeftButtonDown="OnTitleBarDrag">
                <Grid>
                    <TextBlock Text="SpeechX" Foreground="#141414" VerticalAlignment="Center" Margin="16,0,0,0" FontWeight="SemiBold" FontSize="12"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,8,0">
                        <Button Content="_" Width="30" Height="24" Background="Transparent" BorderThickness="0" Click="OnMinimizeClick"/>
                        <Button Content="✕" Width="30" Height="24" Background="Transparent" BorderThickness="0" Click="OnCloseClick"/>
                    </StackPanel>
                </Grid>
            </Border>
            
            <ContentControl x:Name="MainContent" Grid.Row="1" />
        </Grid>
    </Border>
</Window>
