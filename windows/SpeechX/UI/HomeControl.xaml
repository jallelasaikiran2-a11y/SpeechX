<UserControl x:Class="SpeechX.UI.HomeControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:core="clr-namespace:SpeechX.Core"
             Background="Transparent">
    
    <Grid Margin="40">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <!-- Header -->
        <TextBlock x:Name="WelcomeText" Text="Welcome back" FontSize="32" FontWeight="Bold" Foreground="#141414" Margin="0,0,0,20"/>
        
        <!-- Stats Row -->
        <Grid Grid.Row="1" Margin="0,0,0,30">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            
            <!-- Total Words -->
            <Border Grid.Column="0" Background="#F7F6F3" CornerRadius="12" BorderBrush="#141414" BorderThickness="1" Opacity="0.9" Padding="20">
                <StackPanel>
                    <TextBlock Text="Total Words" FontSize="13" FontWeight="SemiBold" Foreground="#666666" Margin="0,0,0,8"/>
                    <TextBlock x:Name="TotalWordsText" Text="0" FontSize="24" FontWeight="Bold" Foreground="#141414"/>
                </StackPanel>
            </Border>
            
            <!-- Streak -->
            <Border Grid.Column="2" Background="#F7F6F3" CornerRadius="12" BorderBrush="#141414" BorderThickness="1" Opacity="0.9" Padding="20">
                <StackPanel>
                    <TextBlock Text="Current Streak" FontSize="13" FontWeight="SemiBold" Foreground="#666666" Margin="0,0,0,8"/>
                    <TextBlock x:Name="StreakText" Text="0 days" FontSize="24" FontWeight="Bold" Foreground="#141414"/>
                </StackPanel>
            </Border>
            
            <!-- Avg WPM -->
            <Border Grid.Column="4" Background="#F7F6F3" CornerRadius="12" BorderBrush="#141414" BorderThickness="1" Opacity="0.9" Padding="20">
                <StackPanel>
                    <TextBlock Text="Avg WPM" FontSize="13" FontWeight="SemiBold" Foreground="#666666" Margin="0,0,0,8"/>
                    <TextBlock x:Name="WpmText" Text="0" FontSize="24" FontWeight="Bold" Foreground="#141414"/>
                </StackPanel>
            </Border>
        </Grid>
        
        <!-- Recent Activity -->
        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            
            <TextBlock Text="Recent activity" FontSize="18" FontWeight="SemiBold" Foreground="#141414" Margin="0,0,0,10"/>
            
            <TextBlock x:Name="EmptyHistoryText" Grid.Row="1" Text="Your recent dictations will appear here" 
                       HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="14" Foreground="#666666" Visibility="Collapsed"/>
                       
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="HistoryList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#F7F6F3" CornerRadius="8" BorderBrush="#141414" BorderThickness="1" Opacity="0.9" Padding="16" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="{Binding Timestamp, StringFormat=t}" FontSize="11" Foreground="#666666" Margin="0,0,0,6"/>
                                    <TextBlock Text="{Binding Typed}" FontSize="14" Foreground="#141414" TextWrapping="Wrap" MaxHeight="40" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
        
        <!-- Footer -->
        <Grid Grid.Row="3" Margin="0,20,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            
            <Button x:Name="SettingsBtn" Grid.Column="0" Content="⚙" FontSize="16" Width="32" Height="32" 
                    Background="#F7F6F3" BorderBrush="#141414" BorderThickness="1" Click="OnSettingsClick"/>
                    
            <TextBlock x:Name="VersionText" Grid.Column="1" Text="Version 1.0" VerticalAlignment="Center" Margin="8,0,0,0" FontSize="11" Foreground="#666666"/>
        </Grid>
    </Grid>
</UserControl>
